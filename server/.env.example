# Copy this file to .env and fill in real values. .env is gitignored.

# Port the API server listens on. Defaults to 4000 if unset.
PORT=4000

# Postgres connection string. Matches the credentials in docker-compose.yml
# (local dev only). Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kitab:kitab@localhost:5432/kitab
