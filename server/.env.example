# Copy this file to .env and fill in real values. .env is gitignored.

# Port the API server listens on. Defaults to 4000 if unset.
PORT=4000

# Postgres connection string. Matches the credentials in docker-compose.yml
# (local dev only). Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://kitab:kitab@localhost:5432/kitab

# Secret used to sign/verify JWTs. Any long random string in dev; a real
# secret (e.g. openssl rand -hex 32) in production.
JWT_SECRET=

# S3 + CloudFront for avatar/cover image storage. Bucket and CloudFront domain
# aren't secret (the bucket itself is private; CloudFront is the only reader),
# but the access key pair is — get it from the kitab-express-server IAM user,
# which is scoped to PutObject/GetObject on this bucket only. Never commit
# real key values here.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=kitab-media-cecil
CLOUDFRONT_DOMAIN=dc4pnktk1r0ki.cloudfront.net
